{
  "installCommand": "bash scripts/install-go.sh",
  "build": {
    "env": {
      "HUGO_VERSION": "0.169.0",
      "GO_VERSION": "1.27.3"
    }
  },
  "buildCommand": "export PATH=\"$HOME/.local/go/bin:$PATH\" && hugo --gc --minify",
  "redirects": [
    {
      "source": "/reads",
      "destination": "/reading",
      "permanent": true
    },
    {
      "source": "/reads/",
      "destination": "/reading/",
      "permanent": true
    }
  ]
}
