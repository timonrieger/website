{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>timonrieger/dotfiles//.github/renovate-base"],
  "git-submodules": {
    "enabled": true
  },
  "pep723": {
    "managerFilePatterns": ["/^scripts/.*\\.py$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GO_VERSION in vercel.json build env",
      "managerFilePatterns": ["/^vercel\\.json$/"],
      "matchStrings": ["\"GO_VERSION\": \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    }
  ],
  "packageRules": [
    {
      "description": "Script dependencies join the base dev tooling group",
      "matchManagers": ["pep723"],
      "groupName": "dev tooling"
    },
    {
      "description": "PaperMod theme submodule and Hugo modules",
      "matchManagers": ["git-submodules", "gomod"],
      "groupName": "site theme and modules"
    },
    {
      "description": "Keep go pins in sync (mise, go.mod, vercel.json)",
      "matchDepNames": ["go"],
      "groupName": "go"
    },
    {
      "description": "Hugo is upgraded manually",
      "matchDepNames": ["hugo"],
      "enabled": false
    }
  ]
}
